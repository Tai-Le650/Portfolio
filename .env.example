# Canonical origin for this site, with no trailing slash.
#
# Consumed by src/lib/site-url.ts, which feeds metadataBase (layout.tsx),
# robots.txt, sitemap.xml, and every canonical + Open Graph URL.
#
# If this is unset AND Vercel's system environment variables are unavailable,
# it falls back to http://localhost:3000 — the site will look correct to a
# visitor while publishing localhost URLs to search engines and crawlers.
#
# Local development can leave this unset; the localhost fallback is intended.
# In Vercel, set it under Settings -> Environment Variables (Production).
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
