# Canonical origin for this site, e.g. https://your-project.vercel.app
#
# Consumed by src/lib/site-url.ts, which feeds metadataBase (layout.tsx),
# robots.txt, sitemap.xml, and every canonical + Open Graph URL.
#
# OPTIONAL. Leave it unset locally — the http://localhost:3000 fallback is
# intended for development.
#
# In Vercel, set it under Settings -> Environment Variables (Production) AFTER
# the first deploy, once the production URL exists. NEXT_PUBLIC_* values are
# inlined at build time, so redeploy after changing it.
#
# Deliberately left commented out: a key that exists with an EMPTY value is
# worse than no key at all. Blank and malformed values are now ignored rather
# than crashing the build, but there is still no reason to define one.
#
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
